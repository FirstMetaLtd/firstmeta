{
  "env": {
    "APP_DEBUG": "false",
    "DB_PORT": "6543"
  },
  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@0.9.0",
      "config": { "includeFiles": ["private/**", "admin/private/**"] }
    },
    {
      "src": "admin/**/*.php",
      "use": "vercel-php@0.9.0",
      "config": { "includeFiles": ["private/**", "admin/private/**"] }
    },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "img/**", "use": "@vercel/static" },
    { "src": "admin/dist/**", "use": "@vercel/static" },
    { "src": "admin/icons/**", "use": "@vercel/static" },
    { "src": "admin/plugins/**", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "robot.txt", "use": "@vercel/static" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://pagead2.googlesyndication.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co; frame-ancestors 'self';" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/home", "destination": "/index.php" },
    { "source": "/login", "destination": "/login.php" },
    { "source": "/register", "destination": "/register.php" },
    { "source": "/verify-email", "destination": "/verify-email.php" },
    { "source": "/team", "destination": "/team.php" },
    { "source": "/logout", "destination": "/logout.php" },
    { "source": "/products", "destination": "/products.php" },
    { "source": "/career", "destination": "/career.php" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.php" },
    { "source": "/product/:slug", "destination": "/product.php?slug=$slug" },
    { "source": "/about", "destination": "/about.php" },
    { "source": "/contact", "destination": "/contact.php" },
    { "source": "/services", "destination": "/services.php" },
    { "source": "/blogs", "destination": "/blogs.php" },
    { "source": "/blog/:slug", "destination": "/blog.php?slug=$slug" },
    { "source": "/service/:slug", "destination": "/service.php?slug=$slug" },
    { "source": "/apply/:job", "destination": "/apply.php?job=$job" },
    { "source": "/forget-password", "destination": "/forget-password.php" },
    { "source": "/change-password", "destination": "/change-password.php" },
    { "source": "/register/:userid", "destination": "/ref-register.php?userid=$userid" },

    { "source": "/admin/home", "destination": "/admin/index.php" },
    { "source": "/admin/delete", "destination": "/admin/delete.php" },
    { "source": "/admin/status", "destination": "/admin/status.php" },
    { "source": "/admin/add-post", "destination": "/admin/add-post.php" },
    { "source": "/admin/edit-post", "destination": "/admin/edit-post.php" },
    { "source": "/admin/edit-admin", "destination": "/admin/edit-admin.php" },
    { "source": "/admin/edit-team", "destination": "/admin/edit-team.php" },
    { "source": "/admin/edit-service", "destination": "/admin/edit-service.php" },
    { "source": "/admin/edit-product", "destination": "/admin/edit-product.php" },
    { "source": "/admin/add-job", "destination": "/admin/add-job.php" },
    { "source": "/admin/edit-job", "destination": "/admin/edit-job.php" },
    { "source": "/admin/posts", "destination": "/admin/posts.php" },
    { "source": "/admin/post", "destination": "/admin/post.php" },
    { "source": "/admin/logos", "destination": "/admin/logos.php" },
    { "source": "/admin/applications", "destination": "/admin/applications.php" },
    { "source": "/admin/products", "destination": "/admin/products.php" },
    { "source": "/admin/services", "destination": "/admin/services.php" },
    { "source": "/admin/category-posts", "destination": "/admin/category-posts.php" },
    { "source": "/admin/edit-category", "destination": "/admin/edit-category.php" },
    { "source": "/admin/settings", "destination": "/admin/settings.php" },
    { "source": "/admin/team", "destination": "/admin/team.php" },
    { "source": "/admin/add-admin", "destination": "/admin/add-admin.php" },
    { "source": "/admin/enquiries", "destination": "/admin/enquiries.php" },
    { "source": "/admin/login", "destination": "/admin/login.php" },
    { "source": "/admin/logout", "destination": "/admin/logout.php" },

    { "source": "/private/(.*)", "destination": "/404.php" },
    { "source": "/admin/private/(.*)", "destination": "/404.php" }
  ]
}
